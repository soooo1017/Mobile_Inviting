# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Never commit the real .env file.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 배경음악 음원이 올라가 있는 Supabase Storage 공개 폴더 주소 (끝에 / 없이). 파일 이름은 bgm001.mp3, bgm002.mp3 …
# 출시 전에 음원을 올린 뒤 채워요. 비워 두면 곡 목록의 미리 듣기 · 초대장 ♪ 버튼이 동작하지 않아요.
EXPO_PUBLIC_BGM_BASE_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/object/public/bgm

# (선택) 하객이 초대장을 여는 웹 페이지 주소 — 끝에 / 없이. 비우면 기본 주소(Vercel)를 써요. 내 도메인을 연결했을 때만 채워요.
# EXPO_PUBLIC_GUEST_BASE_URL=https://xxxx.vercel.app
