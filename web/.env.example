# Vercel (Settings → Environment Variables)와 로컬(web/.env.local)에 같은 값을 넣어요.
# 값은 모바일 앱의 mobile/.env 에 있는 EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY 와 같아요 (anon 키는 공개해도 되는 키예요).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# (선택) 배경음악 음원 폴더 주소 — 앱의 EXPO_PUBLIC_BGM_BASE_URL 과 같은 값(끝 / 없이). 비우면 하객 화면에서 ♪ 버튼이 안 나와요.
NEXT_PUBLIC_BGM_BASE_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/object/public/bgm
